; Engine configuration file.
; Evocure v2.0 - Native Godot 4.7 Bioluminescent Scientific Frontend

config_version=5

[application]

config/name="EVOCURE - Evolutionary Chemical Universe & Cancer Research Engine"
config/description="Interactive 2D Evolutionary Chemical Ecosystem, Modular Chemical Creatures, Multi-Disease Microenvironment & Multi-Provider AI Workbench"
config/version="2.0.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

AppState="*res://scripts/autoload/AppState.gd"
ApiClient="*res://scripts/autoload/ApiClient.gd"

[display]

window/size/viewport_width=1680
window/size/viewport_height=980
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]

locale/test="en"

[rendering]

anti_aliasing/quality/msaa_2d=0
environment/defaults/default_clear_color=Color(0.027, 0.051, 0.106, 1)
