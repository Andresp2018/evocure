# ============================================================================
# EVOCURE - Local Configuration (.env.example)
# ============================================================================
# Copy to .env if you want custom local settings.
# EVOCURE runs locally. No cloud API keys and no internet are required.
#
# Every variable below is read by the code. An earlier version of this file
# listed nineteen more that nothing reads, so setting EVOCURE_MAX_ENTITIES or
# EVOCURE_MODELS_DIR did nothing at all and said nothing about it. Verify with:
#
#   grep -rn EVOCURE_THE_NAME --include=*.py .
#
# If you add a variable here, add the code that reads it in the same change.

# ---------------------------------------------------------------------------
# Server, read by run.py
# ---------------------------------------------------------------------------
EVOCURE_HOST=127.0.0.1
EVOCURE_PORT=8000

# Which interface the launcher starts: godot, web, both, none
EVOCURE_FRONTEND=godot

# Path to the Godot editor or export template, if it is not on PATH
# EVOCURE_GODOT_BIN=

# ---------------------------------------------------------------------------
# Where EVOCURE looks for its data, read by simulation/core/paths.py
# ---------------------------------------------------------------------------
# Both are autodetected and only needed when detection cannot work: a virtual
# environment outside the checkout, a system wide install, or importing evocure
# as a library from an unrelated directory. Check what was resolved with
# `python -m simulation.core.paths`.
#
# The directory holding configs/, data/ and models/
# EVOCURE_HOME=
#
# Where checkpoints, experiment databases and reports are written. Defaults to
# EVOCURE_HOME when that is writable, and to $XDG_STATE_HOME/evocure when it is
# not, which is what a system wide install gives you.
# EVOCURE_DATA_HOME=

# ---------------------------------------------------------------------------
# Compute backend, read by simulation/core/acceleration.py
# ---------------------------------------------------------------------------
# auto, cpu, cuda, rocm, directml, xpu, mps. The CPU path is the
# reproducibility reference; an unavailable backend falls back to it.
EVOCURE_COMPUTE=auto

# ---------------------------------------------------------------------------
# Local AI, all optional. EVOCURE runs with every model absent and names which
# provider answered.
# ---------------------------------------------------------------------------
# auto_local, local_gemma, gemini, openai, deterministic
EVOCURE_AI_PROVIDER=auto_local

# 1 forces the deterministic triage rules instead of the Laya neural checkpoint
# EVOCURE_DISABLE_LAYA_NEURAL=1

# Base URL for scripts/fetch_models.py, if you mirror the weights internally
# EVOCURE_MODEL_MIRROR=

# ---------------------------------------------------------------------------
# Optional external AI providers, off by default
# ---------------------------------------------------------------------------
# Leave blank for fully offline local inference. Keep keys out of version
# control; .env is gitignored.
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Example report, read by scripts/run_pdac_report_experiment.py
# ---------------------------------------------------------------------------
# EVOCURE_REPORT_GENERATIONS=100
# EVOCURE_REPORT_POPULATION=24
# EVOCURE_REPORT_ID=
# EVOCURE_REPORT_USE_LLM_PLANNER=0
