# ============================================================================
# EVOCURE & EVOCURE PLAY - Local Configuration (.env.example)
# ============================================================================
# Copy to .env if you want custom local settings.
# IMPORTANT: EVOCURE runs 100% locally. No cloud API keys or internet required.

EVOCURE_HOST=127.0.0.1
EVOCURE_PORT=8000
EVOCURE_OPEN_BROWSER=true
EVOCURE_DEFAULT_LOCALE=en
EVOCURE_DEFAULT_MODE=PLAY

# Storage & Reproducibility
EVOCURE_DB_PATH=./experiments/evocure.sqlite3
EVOCURE_EXPERIMENTS_DIR=./experiments
EVOCURE_CHECKPOINTS_DIR=./checkpoints
EVOCURE_REPORTS_DIR=./reports
EVOCURE_DATA_DIR=./data
EVOCURE_MODELS_DIR=./models

# Performance & Hardware Limits
EVOCURE_MAX_ENTITIES=4000
EVOCURE_MAX_VISIBLE_PARTICLES=1500
EVOCURE_MEMORY_LIMIT_MB=8192
EVOCURE_ENABLE_GPU_COMPUTE=auto

# Local AI Models (Gemma 4 & Laya AI - strictly local weights or localhost runtime)
# Supported providers: "auto_local", "local_gemma", "gemini", "openai", "deterministic"
EVOCURE_AI_PROVIDER=auto_local
EVOCURE_GEMMA_PROVIDER=auto
EVOCURE_GEMMA_WEIGHTS_PATH=./models/gemma/
EVOCURE_GEMMA_LOCAL_URL=http://127.0.0.1:11434
EVOCURE_GEMMA_MODEL_NAME=gemma4:e4b
EVOCURE_LAYA_ENABLED=true
EVOCURE_LAYA_WEIGHTS_PATH=./models/laya/

# Optional External AI Providers (Google Gemini & OpenAI / Compatible)
# Leave blank for default 100% offline local inference (Local Gemma 4 / Deterministic Fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Frontend Edition: "godot" (Godot 4.7 Bioluminescent) or "web" (HTML5 Canvas / WebGL)
EVOCURE_FRONTEND=godot

